# 复制本文件为 .env 后填入密钥（.env 已被 gitignore，不会提交）
# 复制命令：copy .env.example .env
#
# 真实密钥仅保存在本地 .env 中，不纳入版本管理。
# CI 与离线示例使用 CAD_GENERATE=extractive，不需要密钥。

# 通义千问（阿里云百炼）—— 聊天 + 看图
DASHSCOPE_API_KEY=
CAD_GENERATE=auto
# 上传/管线视觉默认 auto：有密钥走真实 VLM，否则 heuristic
# CAD_VLM_MODE=auto
# CAD_QWEN_MODEL=qwen-plus
# CAD_QWEN_VL_MODEL=qwen-vl-plus

# 可选：DeepSeek（当前接入回答生成；默认使用低成本 Flash）
# DEEPSEEK_API_KEY=
# CAD_DEEPSEEK_MODEL=deepseek-flash
# CAD_DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# CAD_RAG_BACKEND=bm25
# CAD_TOOLS=1
# CAD_RERANK=1
# CAD_LOG_LEVEL=INFO

# OCR 固定 Python 3.13（RapidOCR）；默认用「py -3.13」，也可显式指定：
# CAD_OCR_PYTHON=D:\python\python.exe

# 可选：ODA File Converter 可执行文件或安装目录（Windows）
# ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter 27.1.0\ODAFileConverter.exe
